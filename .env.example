# ---------------------------------------------------------------------------
# InterviewPilot AI - Environment Configuration
# Copy to `.env` and adjust values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=local
DEBUG=true

# Database
POSTGRES_HOST=localhost
# The port compose PUBLISHES, and therefore the one a process running on the
# host -- uvicorn, alembic, pytest -- must use. Containers talk to `db:5432`
# over the compose network and ignore this value entirely.
#
# 5434 rather than 5432 so this stack does not collide with a Postgres already
# installed on the machine. Changing it here changes both sides at once.
#
# Keep this in THIS file, at the repository root. Setting POSTGRES_PORT in
# backend/.env instead would leave the root file deciding which port compose
# publishes while the backend file decided where the app looked for it -- and
# nothing would report the disagreement.
POSTGRES_PORT=5434
POSTGRES_USER=interviewpilot
POSTGRES_PASSWORD=123456
POSTGRES_DB=interviewpilot

# Security (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=ca1e461c47fdd3e2b79dc5df035f8217153cdc2b069dac41c5a2ab77c3d7be6f
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# Email
# "log" writes messages to the log instead of sending them -- reset and
# verification links are copy-pasteable out of the console. No credentials
# needed, and it is REFUSED in production, where printing those links would
# publish account-takeover links to anyone who can read the logs.
# "smtp" is the real transport and works with SES, SendGrid, Mailgun, Postmark
# or Gmail: changing provider is host/port/credentials below, no code change.
EMAIL_BACKEND=log
EMAIL_FROM=InterviewPilot AI <no-reply@interviewpilot.local>
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Mutually exclusive. USE_TLS is implicit TLS (usually port 465), START_TLS is
# STARTTLS (usually 587). Setting both is refused at startup.
SMTP_USE_TLS=false
SMTP_START_TLS=true

# Absolute base URL used for links in emails. Never derived from the request
# Host header, which an attacker controls -- that is how you email someone a
# password-reset link pointing at somebody else's server.
FRONTEND_BASE_URL=http://localhost:3000

# Job queue (Redis + arq)
# Interview evaluations are handed to a separate worker process so they survive
# a restart of the API. Leave REDIS_URL blank to run them in-process instead --
# fine for local development, but an API restart abandons any evaluation in
# flight and the report ends up FAILED. `docker compose up` sets this for you.
# With it set, the `worker` service must be running: arq app.worker.WorkerSettings
REDIS_URL=
# Attempts per evaluation, including the first. arq backs off between them.
EVALUATION_MAX_TRIES=3
EVALUATION_JOB_TIMEOUT_SECONDS=300
# The worker sweeps every 10 minutes for reports left with no job behind them --
# a Redis restart drops the whole queue, and nothing else would ever move those
# rows. A report untouched for this long is queued again; one older than the
# give-up age is failed instead of being retried forever.
# Keep the first comfortably above MAX_TRIES x JOB_TIMEOUT, or the sweep
# re-queues evaluations that are still running.
EVALUATION_STALE_AFTER_SECONDS=1800
EVALUATION_STALE_GIVE_UP_SECONDS=86400

# AI Provider - Google Gemini (Optional but Recommended)
# Leave GEMINI_API_KEY blank to use the built-in deterministic fallback.
# To enable AI-generated questions and evaluation:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key" (or use an existing one)
#   3. Copy the API key and paste it below
#   4. Restart the backend
# When enabled, the system will:
#   - Generate personalized questions based on the candidate's resume
#   - Provide adaptive follow-up questions
#   - Score interviews with intelligent feedback
# Which chat provider generation and evaluation run against.
#
#   gemini     the default; needs nothing beyond GEMINI_API_KEY
#   anthropic  pip install -e ".[anthropic]"
#   openai     pip install -e ".[openai]"
#
# `openai` covers far more than OpenAI: Groq, Ollama, OpenRouter, Together and
# vLLM all speak that API and are reached with AI_BASE_URL below.
#
# Embeddings do NOT follow this setting -- they stay on Gemini, because a Chroma
# collection has a fixed dimensionality and swapping the embedding model would
# need a fresh index.
AI_PROVIDER=gemini
# Model id and key for the chosen provider. Both fall back to the GEMINI_*
# values, so a Gemini deployment sets neither.
AI_MODEL=
AI_API_KEY=
# OpenAI-compatible endpoints only. Blank means genuine OpenAI.
#   Groq    https://api.groq.com/openai/v1
#   Ollama  http://localhost:11434/v1     (local, free, no key needed)
AI_BASE_URL=
# Whether to ask the provider for structured output. A request, not a
# requirement -- replies are extracted either way, because Anthropic has no JSON
# mode at all.
#
# Set to false when an endpoint behind AI_BASE_URL rejects the `response_format`
# field: older Ollama builds and some shims answer 400 to an unknown parameter,
# and the symptom is not an error page but every interview quietly going generic
# (ModelError is what the fallback layer catches). Check /health's
# `ai.calls.failure_rate` if that is what you are seeing.
AI_JSON_MODE=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# RAG vector store (ChromaDB)
# Must be durable storage. On a throwaway path the resume index is lost on
# every restart and RAG silently degrades to truncated raw resume text.
CHROMA_PATH=/var/lib/interviewpilot/chroma

# Storage
# Backend: "local" today; "s3" | "r2" | "minio" in the future.
# "local" or "s3". There is no separate "r2" or "minio" value on purpose: AWS
# S3, Cloudflare R2, MinIO and Backblaze B2 all speak the same API, so they are
# one backend distinguished by S3_ENDPOINT_URL below.
STORAGE_BACKEND=local
# Must live OUTSIDE the application code directory.
STORAGE_LOCAL_PATH=/var/lib/interviewpilot/storage
MAX_UPLOAD_SIZE_BYTES=5242880

# S3-compatible storage. Only read when STORAGE_BACKEND=s3.
#
#   AWS S3   leave S3_ENDPOINT_URL blank, set a real S3_REGION
#   R2       https://<account-id>.r2.cloudflarestorage.com   region: auto
#   MinIO    http://localhost:9000                           any region
#   B2       https://s3.<region>.backblazeb2.com
#
# For local development: `docker compose --profile s3 up -d minio`, then create
# a bucket at http://localhost:9001 (minioadmin / minioadmin).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
# Leave blank on AWS to use boto3's own credential chain -- an instance role
# beats a key pair nobody has to rotate. R2, MinIO and B2 need these set.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Retrieval tuning
# Cosine distance beyond which a retrieved chunk is dropped as unrelated
# rather than padding the prompt. Chroma cosine distance runs 0 (identical) to
# 2 (opposite), and the comparison is strict, so 1.0 means "drop anything no
# better than orthogonal". Loosen it if retrieval starts returning nothing;
# the band a model puts related text in varies between embedding models.
RAG_MAX_DISTANCE=1.0
# How long a cached embedding vector lives. An embedding is a pure function of
# (model, text), so entries never go stale -- the TTL reclaims space, and a
# model change is already a different key. Requires REDIS_URL; without one,
# every index pays the provider in full.
EMBEDDING_CACHE_TTL_SECONDS=2592000

# Tracing (LangSmith) - optional
# retrieval_metrics says how often retrieval comes back empty; tracing says why
# *this* interview's questions were poor, by tying one operation's rewrite,
# retrieval, fusion, prompt and parse into a single span tree.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interviewpilot
# Self-hosted instances only; unset uses LangSmith's cloud.
LANGSMITH_ENDPOINT=
# Whether traces carry the actual prompts and retrieved chunks.
#
# A trace's payload is resume text: the prompt contains it, and the retrieved
# chunks come from Chroma, which holds the resume UNREDACTED on purpose. Turning
# this on ships to the tracing service exactly what the masking layer exists to
# withhold, and does it silently -- nobody reviews a trace the way they review a
# request. Reasonable for local debugging or a self-hosted endpoint.
LANGSMITH_TRACE_CONTENT=false

# Error reporting (Sentry) - optional
# The counters at /health say how often something failed; this says what the
# traceback was. Off until a DSN is set.
#
# Wired at the *swallow points*, not only at the ASGI layer: this application
# catches exceptions in 42 places by design, so a reporter watching only for
# unhandled ones would be quietest exactly when things are worst.
SENTRY_DSN=
# Which build this is. Worth setting anywhere real -- "since when" is the first
# question about a new error and is unanswerable without it.
SENTRY_RELEASE=
# Performance tracing. Off: the AI pipeline is already traced by LangSmith,
# which knows what a retrieval is.
SENTRY_TRACES_SAMPLE_RATE=0.0
# Whether crash reports carry request bodies and local variables.
#
# Same decision as LANGSMITH_TRACE_CONTENT, with more force: the locals at the
# point of a crash here are `prompt`, `resume_text`, `transcript` and `answer`.
# Turning this on ships a third party exactly what the masking layer exists to
# withhold, silently -- nobody reviews a crash report the way they review a
# request. Reasonable only against a self-hosted Sentry.
SENTRY_SEND_CONTENT=false

# Per-user quotas
# How many resumes one account may keep. An *occupancy* ceiling, enforced by
# counting rows -- so deleting a resume frees the quota, and a Redis restart
# cannot grant unlimited uploads. Set to 0 to switch the quota off.
MAX_RESUMES_PER_USER=10
# Interviews one user may start per day. A *consumption* cap, so it is a counter:
# starting an interview spends a provider call and deleting the session cannot
# un-spend it. The hourly AI limit bounds bursts; this bounds the day.
RATE_LIMIT_INTERVIEW_CREATES=5
RATE_LIMIT_INTERVIEW_WINDOW_SECONDS=86400
