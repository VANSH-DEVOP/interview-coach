# ---------------------------------------------------------------------------
# InterviewPilot AI - Environment Configuration
# Copy to `.env` and adjust values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=local
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=interviewpilot
POSTGRES_PASSWORD=123456
POSTGRES_DB=interviewpilot

# Security (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=ca1e461c47fdd3e2b79dc5df035f8217153cdc2b069dac41c5a2ab77c3d7be6f
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# AI Provider - Google Gemini (Optional but Recommended)
# Leave GEMINI_API_KEY blank to use the built-in deterministic fallback.
# To enable AI-generated questions and evaluation:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key" (or use an existing one)
#   3. Copy the API key and paste it below
#   4. Restart the backend
# When enabled, the system will:
#   - Generate personalized questions based on the candidate's resume
#   - Provide adaptive follow-up questions
#   - Score interviews with intelligent feedback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Storage
# Backend: "local" today; "s3" | "r2" | "minio" in the future.
STORAGE_BACKEND=local
# Must live OUTSIDE the application code directory.
STORAGE_LOCAL_PATH=/var/lib/interviewpilot/storage
MAX_UPLOAD_SIZE_BYTES=5242880

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
