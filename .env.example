# ---------------------------------------------------------------------------
# InterviewPilot AI - Environment Configuration
# Copy to `.env` and adjust values. Never commit `.env`.
# ---------------------------------------------------------------------------

# Application
ENVIRONMENT=local
DEBUG=true

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=interviewpilot
POSTGRES_PASSWORD=123456
POSTGRES_DB=interviewpilot

# Security (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=ca1e461c47fdd3e2b79dc5df035f8217153cdc2b069dac41c5a2ab77c3d7be6f
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000"]

# Job queue (Redis + arq)
# Interview evaluations are handed to a separate worker process so they survive
# a restart of the API. Leave REDIS_URL blank to run them in-process instead --
# fine for local development, but an API restart abandons any evaluation in
# flight and the report ends up FAILED. `docker compose up` sets this for you.
# With it set, the `worker` service must be running: arq app.worker.WorkerSettings
REDIS_URL=
# Attempts per evaluation, including the first. arq backs off between them.
EVALUATION_MAX_TRIES=3
EVALUATION_JOB_TIMEOUT_SECONDS=300

# AI Provider - Google Gemini (Optional but Recommended)
# Leave GEMINI_API_KEY blank to use the built-in deterministic fallback.
# To enable AI-generated questions and evaluation:
#   1. Go to https://aistudio.google.com/app/apikey
#   2. Click "Create API Key" (or use an existing one)
#   3. Copy the API key and paste it below
#   4. Restart the backend
# When enabled, the system will:
#   - Generate personalized questions based on the candidate's resume
#   - Provide adaptive follow-up questions
#   - Score interviews with intelligent feedback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# RAG vector store (ChromaDB)
# Must be durable storage. On a throwaway path the resume index is lost on
# every restart and RAG silently degrades to truncated raw resume text.
CHROMA_PATH=/var/lib/interviewpilot/chroma

# Storage
# Backend: "local" today; "s3" | "r2" | "minio" in the future.
STORAGE_BACKEND=local
# Must live OUTSIDE the application code directory.
STORAGE_LOCAL_PATH=/var/lib/interviewpilot/storage
MAX_UPLOAD_SIZE_BYTES=5242880

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
