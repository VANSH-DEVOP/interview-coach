# ---------------------------------------------------------------------------
# InterviewPilot AI — production configuration
#
# Copy to `.env` on the deployment host. This is not `.env.example` with
# different numbers: every value below either MUST change from its development
# default or behaves differently once ENVIRONMENT=production.
#
# The application refuses to start in production with several of these left at
# a development default (app/core/startup_checks.py). That guard exists because
# each one is safe on a laptop, a hole on the internet, and silent in both --
# it reports every problem at once so the fix is a single pass.
#
# Before you deploy, two things are not configuration and cannot be fixed here:
#
#   1. HTTPS is required, not recommended. Session cookies are marked Secure in
#      production and browsers silently discard those over plain HTTP on any
#      host but localhost. Login appears to succeed and every request after it
#      is unauthenticated. Terminate TLS in front of both services.
#
#   2. The Gemini free tier allows 20 requests per day FOR THE WHOLE ACCOUNT,
#      and one complete interview costs about 23. A public deployment on the
#      free tier is exhausted by its first visitor; everyone after them gets
#      the deterministic fallback questions. Move to a paid tier, or point
#      AI_PROVIDER at a local model, before this is meaningfully public.
# ---------------------------------------------------------------------------

# -- Application -------------------------------------------------------------
# Turns on the HSTS header, removes /docs, and activates the startup guard.
ENVIRONMENT=production
DEBUG=false

# Both must be the deployed frontend's origin, over https.
# CORS_ORIGINS is what the browser is allowed to call the API from.
# FRONTEND_BASE_URL builds password-reset and email-verification links, which
# are opened outside the browser session -- a wrong value here does not look
# broken, it makes account recovery impossible while every reset reports sent.
CORS_ORIGINS=["https://interviewpilot.example"]
FRONTEND_BASE_URL=https://interviewpilot.example

# Baked into the browser bundle AT BUILD TIME, so changing it needs a rebuild
# rather than a restart. The API address the browser uses.
NEXT_PUBLIC_API_URL=https://api.interviewpilot.example/api/v1

# -- Security ----------------------------------------------------------------
# Generate, do not invent: openssl rand -hex 32
# The development default is in this repository, so anyone who has read it can
# mint a token for any account.
JWT_SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# -- Database ----------------------------------------------------------------
# Generate this too. `interviewpilot` is the development default and is refused.
POSTGRES_USER=interviewpilot
POSTGRES_PASSWORD=
POSTGRES_DB=interviewpilot
# Host-side port. Containers reach Postgres at db:5432 regardless.
POSTGRES_PORT=5434

# -- AI provider --------------------------------------------------------------
# A key that reaches a log becomes a spend the moment the account stops being
# free. The `?key=` query-string leak that caused that here was fixed in
# e0e1ad6 and httpx/httpcore are pinned to WARNING; rotate if one ever does
# reach a log again.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# gemini | anthropic | openai. `openai` plus AI_BASE_URL also reaches Groq,
# Ollama and OpenRouter -- which is the realistic answer to the 20/day ceiling.
# Embeddings always stay on Gemini; see config.py for why.
AI_PROVIDER=gemini
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_JSON_MODE=true
AI_STREAMING=false

# -- Rate limits and quotas ----------------------------------------------------
# These are the code defaults, sized for a shared free-tier deployment: one
# user cannot spend more than their share of 20 requests a day. Raise them in
# proportion to the provider budget, not to taste -- a limit above the budget
# bounds nothing.
#
# The window matters more than the count: a per-hour window cannot bound a
# per-day budget at any value.
RATE_LIMIT_AI_REQUESTS=10
RATE_LIMIT_AI_WINDOW_SECONDS=86400
RATE_LIMIT_UPLOAD_REQUESTS=2
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=86400
RATE_LIMIT_INTERVIEW_CREATES=2
RATE_LIMIT_INTERVIEW_WINDOW_SECONDS=86400
MAX_RESUMES_PER_USER=10
# Credential-stuffing defence, per IP. Deliberately a short window: a daily one
# would lock a legitimate user out for a day over a few typos.
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
RATE_LIMIT_ENABLED=true

# -- Email ---------------------------------------------------------------------
# EMAIL_BACKEND=log is REFUSED in production: it writes reset links to the log
# in cleartext, which publishes account-takeover links to anyone who can read
# them while every flow still reports success.
#
# EMAIL_FROM must be an address the provider will authorise. Gmail rewrites
# anything that is not the authenticated account.
EMAIL_BACKEND=smtp
EMAIL_FROM=InterviewPilot AI <no-reply@interviewpilot.example>
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
# An App Password, if the provider issues one, with any display spaces removed.
SMTP_PASSWORD=
# Implicit TLS on 465. Use 587 with SMTP_START_TLS=true instead if the host
# allows it -- some networks block outbound 587 and 25 while 465 is open.
SMTP_USE_TLS=true
SMTP_START_TLS=false
SMTP_TIMEOUT_SECONDS=10

# -- Storage -------------------------------------------------------------------
# "local" writes to a volume, which dies with the host. Use "s3" for anything
# with more than one replica or a rebuild story. One backend covers AWS S3,
# Cloudflare R2, MinIO and Backblaze B2 -- they differ by S3_ENDPOINT_URL.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/var/lib/interviewpilot/storage
MAX_UPLOAD_SIZE_BYTES=5242880
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
# Leave blank on AWS to use the instance role, which beats a key pair nobody
# has to rotate.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# -- Queue and vector store -----------------------------------------------------
# Without REDIS_URL, evaluations run in the web process and a restart loses
# them. compose sets both of these for containers.
REDIS_URL=redis://redis:6379
# Must be durable storage. On a throwaway path the resume index is lost on
# restart and retrieval silently degrades to truncated resume text.
CHROMA_PATH=/var/lib/interviewpilot/chroma

# -- Observability ---------------------------------------------------------------
# Metrics describe the deployment -- signups, provider failure rate, remaining
# quota -- so set a token or restrict /metrics at the proxy. Off answers 404.
METRICS_ENABLED=true
METRICS_TOKEN=

# "Since when did this start" is the first question about any error. `make up`
# stamps SENTRY_RELEASE from the git SHA.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=interviewpilot

# Both of these ship resume text and prompts to a third party. Leave them false
# unless the endpoint is self-hosted; this is the data masking.py exists to
# withhold, and nobody reviews a trace or a crash report the way they review a
# request.
SENTRY_SEND_CONTENT=false
LANGSMITH_TRACE_CONTENT=false
